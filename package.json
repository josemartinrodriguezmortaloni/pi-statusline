{
  "name": "@m4s1t4/pi-statusline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi extension that replaces the footer with a configurable statusline of segments",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "prepare": "git config core.hooksPath .githooks",
    "complexity": "eslint src",
    "deps": "depcruise src"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-ai": "1.0.1",
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@earendil-works/pi-tui": "1.0.1",
    "@types/node": "26.6.3",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.11.0",
    "typebox": "1.3.27",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
